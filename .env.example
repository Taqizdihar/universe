# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Email Configuration (Brevo SMTP — Port 2525)
# Uses Brevo's SMTP relay on port 2525 (STARTTLS) to bypass Render's firewall
# which blocks standard SMTP ports (465, 587) on free-tier instances.
# Sign up at: https://www.brevo.com → SMTP & API → SMTP Settings
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="2525"
SMTP_USER="your-brevo-login@example.com"
SMTP_PASS="your-brevo-smtp-key"
EMAIL_FROM="noreply@yourdomain.com"

# Frontend Dashboard URL — Used in email notification CTA buttons
# Set this to this environment's frontend domain so the "Buka Dashboard CMS" link
# in email notifications routes to the frontend, not the backend API.
FRONTEND_URL="https://your-cms-domain.example"
# Additional trusted CMS dashboard origins, separated by commas. Public content APIs
# allow cross-origin reads without cookies; authenticated APIs use this allowlist.
CORS_ALLOWED_ORIGINS="https://another-cms-domain.example"

# Required backend-only signing secret, at least 32 bytes. Keep the existing value
# on an active deployment to avoid invalidating legitimate JWT sessions.
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-bytes"

# Backend MySQL connection. Set these separately for each deployment.
# The backend reads DB_* from its runtime environment; never use Aiven values in Kroombox.
DB_HOST="your-mysql-host"
DB_PORT="3306"
DB_USER="your-mysql-user"
DB_PASSWORD="your-mysql-password"
DB_NAME="your-mysql-database"
# For internal Kroombox MySQL hosts such as mysql, plaintext is the default.
# For external hosts, verified TLS is the default. Override explicitly if needed.
# DB_SSL_MODE="verify"
# Set only when DB_SSL_MODE=verify and your provider supplies a custom CA PEM.
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\\n...\\n-----END CERTIFICATE-----"
